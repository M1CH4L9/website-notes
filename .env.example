# Neon (Vercel Marketplace ustawia zwykle DATABASE_URL albo POSTGRES_URL)
DATABASE_URL=postgresql://notes:notes@127.0.0.1:5432/website_notes

# GitHub OAuth App - callback: https://<domena>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Opcjonalnie (domyślnie M1CH4L9)
# ADMIN_GITHUB_LOGIN=M1CH4L9

# Opcjonalnie, gdy kanoniczny adres różni się od request origin
# PUBLIC_SITE_URL=https://twoja-domena.vercel.app

# Opcjonalnie lokalny Chromium dla generatora PDF (na Vercel używa dołączonego pakietu)
# PDF_CHROMIUM_PATH=/usr/bin/chromium

# Resend (wymagane przy rejestracji, potwierdzaniu adresu i resecie hasła)
# RESEND_API_KEY=
# AUTH_EMAIL_FROM="Notatnik <konto@twoja-domena.pl>"
