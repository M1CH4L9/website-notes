---
import '@fontsource-variable/figtree/wght.css';
import '@fontsource-variable/figtree/wght-italic.css';
import '@fontsource-variable/nunito/wght.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/account.css';

import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import figtreeLatinExt from '@fontsource-variable/figtree/files/figtree-latin-ext-wght-normal.woff2?url';
import nunitoLatin from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';

import { ClientRouter } from 'astro:transitions';
import CatMark from '../components/CatMark.astro';
import PawTrail from '../components/PawTrail.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  editor?: boolean;
}

const { title, description = site.description, wide = false, editor = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const user = Astro.locals.user;
const serverTheme = user?.pref_theme ?? undefined;
const serverCute = user?.pref_cute == null ? undefined : user.pref_cute ? '1' : '0';
---

<!doctype html>
<html
  lang={site.lang}
  data-theme="dark"
  data-cute="false"
  data-server-theme={serverTheme}
  data-server-cute={serverCute}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/oauth-icon.png" />
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtreeLatinExt} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={nunitoLatin} as="font" type="font/woff2" crossorigin />
    <ThemeInit />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body
    ontouchstart=""
    data-auth={user ? '1' : '0'}
    data-csrf={Astro.locals.csrf ?? undefined}
    class:list={[wide && 'is-wide-page', editor && 'is-editor-page']}
  >
    {/* Pusty ontouchstart sprawia, że iOS Safari pokazuje stany :active po dotknięciu. */}
    <a class="skip-link" href="#tresc">Przejdź do treści</a>

    <header class="site-header" transition:name="site-header">
      <div class="container site-header-inner">
        <a class="brand" href="/" aria-label={`${site.name}, strona główna`}>
          <CatMark class="brand-mark" />
          <span class="brand-name">{site.name}<span class="brand-dot">.</span></span>
        </a>
        <div class="site-header-actions">
          <ThemeSwitch />
          <div class="header-actions-desktop">
            {
              user ? (
                <>
                  <a class="button button-secondary header-action" href="/moje/">
                    Notatki
                  </a>
                  <a class="button button-secondary header-action" href="/profil/">
                    Konto
                  </a>
                  <form method="post" action="/api/auth/logout" class="header-logout">
                    {Astro.locals.csrf && <input type="hidden" name="csrf" value={Astro.locals.csrf} />}
                    <button type="submit" class="button button-secondary header-action">Wyloguj</button>
                  </form>
                </>
              ) : (
                <>
                  <a class="button button-secondary header-action" href="/logowanie">
                    Zaloguj
                  </a>
                  <a class="button header-action" href="/rejestracja">
                    Zarejestruj
                  </a>
                </>
              )
            }
          </div>
          <div class="nav-menu-wrap">
            <button
              type="button"
              class="nav-menu-toggle"
              aria-expanded="false"
              aria-controls="nav-menu"
              aria-haspopup="true"
              data-nav-toggle
            >
              <span class="visually-hidden">Menu</span>
              <span class="nav-menu-icon" aria-hidden="true"></span>
            </button>
            <div class="nav-menu" id="nav-menu" data-nav-menu hidden>
              <div class="nav-menu-backdrop" data-nav-close tabindex="-1"></div>
              <div class="nav-menu-panel" role="menu" aria-label="Menu">
                <nav class="nav-menu-links" aria-label="Konto">
                  {
                    user ? (
                      <>
                        <a class="nav-menu-item" role="menuitem" href="/moje/">Notatki</a>
                        <a class="nav-menu-item" role="menuitem" href="/profil/">Konto</a>
                        {user.is_admin && (
                          <a class="nav-menu-item" role="menuitem" href="/admin/prosby/">Prośby</a>
                        )}
                        <form method="post" action="/api/auth/logout" class="nav-menu-form">
                          {Astro.locals.csrf && <input type="hidden" name="csrf" value={Astro.locals.csrf} />}
                          <button type="submit" class="nav-menu-item" role="menuitem">Wyloguj</button>
                        </form>
                      </>
                    ) : (
                      <>
                        <a class="nav-menu-item" role="menuitem" href="/logowanie">Zaloguj</a>
                        <a class="nav-menu-item nav-menu-item-accent" role="menuitem" href="/rejestracja">
                          Zarejestruj
                        </a>
                      </>
                    )
                  }
                </nav>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main id="tresc" class="site-main">
      <div class:list={['container', wide && 'container-wide']}>
        <slot />
      </div>
    </main>

    {
      !editor && (
        <footer class="site-footer">
          <div class="container site-footer-inner">
            <span class="footer-name">{site.title}</span>
            <PawTrail class="footer-paws" />
          </div>
        </footer>
      )
    }

    <script>
      const g = window as Window & { __navMenuBooted?: boolean; __navMenuClosing?: boolean };

      document.addEventListener('astro:before-preparation', event => {
        const header = document.querySelector('.site-header');
        const timer = window.setTimeout(() => header?.classList.add('is-loading'), 200);
        const clear = () => {
          clearTimeout(timer);
          header?.classList.remove('is-loading');
        };
        const load = event.loader;
        event.loader = async () => {
          try { await load(); } finally { clear(); }
        };
        event.signal.addEventListener('abort', clear, { once: true });
      });

      function getParts() {
        return {
          menu: document.querySelector<HTMLElement>('[data-nav-menu]'),
          toggle: document.querySelector<HTMLButtonElement>('[data-nav-toggle]'),
        };
      }

      function closeNav(immediate = false) {
        const { menu, toggle } = getParts();
        if (!menu || !toggle || menu.hidden) return;

        const finish = () => {
          menu.hidden = true;
          menu.classList.remove('is-open', 'is-closing');
          document.body.classList.remove('nav-open');
          toggle.setAttribute('aria-expanded', 'false');
          g.__navMenuClosing = false;
        };

        if (immediate || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          finish();
          return;
        }

        g.__navMenuClosing = true;
        menu.classList.remove('is-open');
        menu.classList.add('is-closing');
        const panel = menu.querySelector<HTMLElement>('.nav-menu-panel');
        const onEnd = (event: TransitionEvent) => {
          if (event.target !== panel && event.target !== menu.querySelector('.nav-menu-backdrop')) return;
          panel?.removeEventListener('transitionend', onEnd);
          finish();
        };
        panel?.addEventListener('transitionend', onEnd);
        window.setTimeout(finish, 280);
      }

      function openNav() {
        const { menu, toggle } = getParts();
        if (!menu || !toggle) return;
        g.__navMenuClosing = false;
        menu.classList.remove('is-closing');
        menu.hidden = false;
        document.body.classList.add('nav-open');
        toggle.setAttribute('aria-expanded', 'true');
        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => menu.classList.add('is-open'));
        });
      }

      if (!g.__navMenuBooted) {
        g.__navMenuBooted = true;
        document.addEventListener('click', (event) => {
          const target = event.target as HTMLElement | null;
          if (target?.closest('[data-nav-toggle]')) {
            const { menu } = getParts();
            if (!menu || g.__navMenuClosing) return;
            if (menu.hidden) openNav();
            else closeNav();
            return;
          }
          if (target?.closest('[data-nav-close]')) {
            closeNav();
            return;
          }
          const { menu } = getParts();
          if (menu && !menu.hidden && !target?.closest('.nav-menu-wrap')) {
            closeNav();
          }
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeNav();
        });
        document.addEventListener('astro:page-load', () => closeNav(true));
        document.addEventListener('astro:before-swap', () => closeNav(true));
      }
    </script>
  </body>
</html>
