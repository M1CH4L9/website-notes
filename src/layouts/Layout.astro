---
import '@fontsource-variable/nunito-sans';
import '@fontsource/lora/latin-400.css';
import '@fontsource/lora/latin-400-italic.css';
import '@fontsource/lora/latin-ext-400.css';
import '@fontsource/lora/latin-ext-400-italic.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
interface Props { title?: string; description?: string; }
const { title = 'Notatnik — małe notatki, wielkie odkrycia', description = 'Przytulne miejsce na notatki z informatyki. Przeglądaj tematy i ucz się we własnym rytmie.' } = Astro.props;
---
<!doctype html>
<html lang="pl" data-theme="cat">
<head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <meta name="description" content={description}/><meta name="theme-color" content="#fbf8f6"/>
 <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
 <title>{title}</title>
 <script is:inline>
  try { const t = localStorage.getItem('notatnik-theme'); if (['cat','light','dark'].includes(t)) document.documentElement.dataset.theme = t; } catch {}
 </script>
</head>
<body>
 <a href="#main" class="skip-link">Przejdź do treści</a>
 <header class="site-header"><div class="header-inner">
  <a href="/" class="brand" aria-label="Notatnik — strona główna"><span class="brand-icon"><Icon name="cat" size={27}/></span>notatnik<span class="brand-dot">.</span></a>
  <nav aria-label="Nawigacja główna"><a href="/" class="nav-library"><Icon name="book" size={17}/> Biblioteka</a></nav>
  <div class="theme-control"><Icon name="cat" size={17}/><label class="sr-only" for="theme">Motyw strony</label><select id="theme" aria-label="Motyw strony"><option value="cat">Kotek</option><option value="light">Jasny</option><option value="dark">Ciemny</option></select></div>
 </div></header>
 <main id="main"><slot/></main>
 <footer class="site-footer"><a href="/" class="footer-brand"><Icon name="cat" size={20}/> notatnik.</a><span>Trochę wiedzy, dużo ciekawości.</span><span class="footer-end">Zapisane z <Icon name="heart" size={14}/></span></footer>
 <script>
  const select = document.querySelector<HTMLSelectElement>('#theme');
  if (select) {
   select.value = document.documentElement.dataset.theme || 'cat';
   select.addEventListener('change', () => { document.documentElement.dataset.theme = select.value; try { localStorage.setItem('notatnik-theme', select.value); } catch {} });
  }
 </script>
</body>
</html>
