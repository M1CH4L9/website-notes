---
/*
 * Kot wyglądający zza krawędzi karty. Krawędź karty wypada na y=40:
 * powyżej widać głowę, poniżej tylko łapki oparte o kartę.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 120 50" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="cat-peek-clip">
      <rect x="0" y="0" width="120" height="40"></rect>
    </clipPath>
  </defs>
  <g class="cat-peek-head" clip-path="url(#cat-peek-clip)">
    <path
      d="M39.5 31 36.5 9.5 52 18.5c5.2-1.5 10.8-1.5 16 0l15.5-9L80.5 31c3 13-6.5 22.5-20.5 22.5S36.5 44 39.5 31z"
      fill="var(--cat-fur)"
      stroke="var(--cat-line)"
      stroke-width="2.5"
      stroke-linejoin="round"></path>
    <path d="M41.5 16.5 43 26l6.5-5.5z" fill="var(--cat-pink)"></path>
    <path d="M78.5 16.5 77 26l-6.5-5.5z" fill="var(--cat-pink)"></path>
    <ellipse cx="51.5" cy="33.5" rx="2.3" ry="3.1" fill="var(--cat-line)"></ellipse>
    <ellipse cx="68.5" cy="33.5" rx="2.3" ry="3.1" fill="var(--cat-line)"></ellipse>
  </g>
  <g fill="var(--cat-fur)" stroke="var(--cat-line)" stroke-width="2.3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M27 40.5c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6v2.5c0 2.5-2.9 4-6.5 4s-6.5-1.5-6.5-4z"></path>
    <path d="M80 40.5c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6v2.5c0 2.5-2.9 4-6.5 4s-6.5-1.5-6.5-4z"></path>
  </g>
  <g fill="none" stroke="var(--cat-line)" stroke-width="1.5" stroke-linecap="round">
    <path d="M31.3 43v2.2M35.7 43v2.2M84.3 43v2.2M88.7 43v2.2"></path>
  </g>
</svg>
