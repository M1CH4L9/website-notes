---
import Arrow from './Arrow.astro';
import CatSleeping from './CatSleeping.astro';
import { countNotes, formatDate, isoDate } from '../lib/format';
import type { Subject } from '../lib/notes';

interface Props { subject: Subject; path?: string }
const { subject, path = '' } = Astro.props;
const folders = subject.folders.filter(folder => folder.parent === path);
const notes = subject.notes.filter(note => !note.archive && (note.folder ?? '') === path);
---
{folders.length + notes.length > 0 ? (
  <div class="note-list-wrap">
    <CatSleeping class="list-cat" />
    <ul class="note-list">
      {folders.map(folder => (
        <li><a class="note-link" href={folder.url}>
          <span class="note-title"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 7V5h6l2 2h10v12H3Z" /></svg> {folder.title}</span>
          {folder.description && <span class="note-desc">{folder.description}</span>}
          <span class="note-date">{countNotes(subject.notes.filter(note => !note.archive && (note.folder === folder.path || note.folder?.startsWith(`${folder.path}/`))).length)}</span>
          <Arrow class="note-arrow" />
        </a></li>
      ))}
      {notes.map(note => (
        <li><a class="note-link" href={note.url}>
          <span class="note-title">{note.title}</span>
          {note.description && <span class="note-desc">{note.description}</span>}
          {note.updated && <time class="note-date" datetime={isoDate(note.updated)}>{formatDate(note.updated)}</time>}
          <Arrow class="note-arrow" />
        </a></li>
      ))}
    </ul>
  </div>
) : <div class="empty"><p class="empty-title">Tu jeszcze nic nie ma</p></div>}
<style>
  .note-title svg { vertical-align: -.18em; margin-inline-end: .25rem; }
</style>
