---
/*
 * Sterowanie wyglądem w nagłówku: suwak trybu cute i przełącznik jasny/ciemny.
 *
 * Stan widoczny (pozycja suwaka, ikona słońca albo księżyca) wynika z atrybutów
 * data-theme i data-cute na <html>, które ustawia ThemeInit.astro, więc jest poprawny
 * przed uruchomieniem tego skryptu. Skrypt obsługuje kliknięcia, zapis i atrybuty ARIA.
 */
---

<div class="theme-controls">
  <button type="button" class="cute-switch" role="switch" aria-checked="false" aria-label="Tryb cute" title="Tryb cute" data-cute-toggle>
    <span class="cute-switch-label" aria-hidden="true">cute</span>
    <span class="cute-switch-track">
      <span class="cute-switch-thumb">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            class="cute-thumb-head"
            d="M4.6 3.6 5.6 10.4C4.5 16 7.8 20.4 12 20.4s7.5-4.4 6.4-10L19.4 3.6 14.8 6.8c-1.8-.5-3.8-.5-5.6 0z"
            stroke-linejoin="round"></path>
          <g class="cute-thumb-eyes-open">
            <circle cx="9.4" cy="12.8" r="1.25"></circle>
            <circle cx="14.6" cy="12.8" r="1.25"></circle>
          </g>
          <path class="cute-thumb-eyes-closed" d="M8 12.4c.7 1 2.1 1 2.8 0M13.2 12.4c.7 1 2.1 1 2.8 0" stroke-linecap="round"></path>
        </svg>
      </span>
    </span>
  </button>

  <button type="button" class="mode-toggle" aria-label="Przełącz na motyw jasny" title="Przełącz na motyw jasny" data-theme-toggle>
    <svg class="mode-icon mode-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M19.5 14.2A7.8 7.8 0 0 1 9.8 4.5a7.8 7.8 0 1 0 9.7 9.7z"></path>
    </svg>
    <svg class="mode-icon mode-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="3.9"></circle>
      <path d="M12 3v1.8M12 19.2V21M3 12h1.8M19.2 12H21M5.64 5.64l1.27 1.27M17.09 17.09l1.27 1.27M18.36 5.64l-1.27 1.27M6.91 17.09l-1.27 1.27"></path>
    </svg>
  </button>
</div>

<script>
  type Theme = 'dark' | 'light';

  const THEME_COLORS: Record<string, string> = {
    dark: '#151b23',
    light: '#ffffff',
    'cute-dark': '#251822',
    'cute-light': '#ffffff',
  };

  const root = document.documentElement;
  const currentTheme = (): Theme => (root.dataset.theme === 'light' ? 'light' : 'dark');
  const isCute = () => root.dataset.cute === 'true';

  function save(key: string, value: string) {
    try {
      localStorage.setItem(key, value);
    } catch {
      // Tryb prywatny lub zablokowany zapis: ustawienie działa do końca wizyty.
    }
  }

  /** Uzgadnia atrybuty ARIA, podpowiedzi i kolor paska przeglądarki ze stanem na <html>. */
  function sync() {
    const theme = currentTheme();
    const cute = isCute();
    const label = theme === 'dark' ? 'Przełącz na motyw jasny' : 'Przełącz na motyw ciemny';
    for (const modeButton of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      modeButton.setAttribute('aria-label', label);
      modeButton.setAttribute('title', label);
    }
    for (const cuteButton of document.querySelectorAll<HTMLButtonElement>('[data-cute-toggle]')) {
      cuteButton.setAttribute('aria-checked', String(cute));
    }
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', THEME_COLORS[(cute ? 'cute-' : '') + theme]);
  }

  /** Zmienia wygląd z płynnym przejściem tam, gdzie przeglądarka to potrafi. */
  function change(update: () => void) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion || typeof document.startViewTransition !== 'function') {
      update();
      sync();
      return;
    }
    root.classList.add('is-theme-switching');
    const transition = document.startViewTransition(() => {
      update();
      sync();
    });
    transition.finished.finally(() => root.classList.remove('is-theme-switching'));
  }

  const g = window as Window & { __themeSwitchBooted?: boolean };
  if (!g.__themeSwitchBooted) {
    g.__themeSwitchBooted = true;

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest('[data-theme-toggle]')) {
        const next: Theme = currentTheme() === 'dark' ? 'light' : 'dark';
        change(() => {
          root.dataset.theme = next;
        });
        save('theme', next);
        return;
      }
      if (target?.closest('[data-cute-toggle]')) {
        const next = !isCute();
        change(() => {
          root.dataset.cute = String(next);
        });
        save('cute', next ? '1' : '0');
      }
    });

    // Zmiana w innej karcie.
    window.addEventListener('storage', (event) => {
      if (event.key === 'theme' && (event.newValue === 'dark' || event.newValue === 'light')) {
        root.dataset.theme = event.newValue;
        sync();
      }
      if (event.key === 'cute' && event.newValue !== null) {
        root.dataset.cute = String(event.newValue === '1');
        sync();
      }
    });

    document.addEventListener('astro:page-load', sync);
  }

  sync();
</script>
