---
/* Znak strony: różowy kafelek z konturem kociej głowy. Kolory są stałe (--brand-* w tokens.css). */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="9.5" fill="var(--brand-tile)"></rect>
  <g fill="none" stroke="var(--brand-line)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M9.6 9.2 10.5 14.3C9.6 18.9 12.2 22.8 16 22.8s6.4-3.9 5.5-8.5l.9-5.1-3.7 2.5c-1.8-.5-3.6-.5-5.4 0z"></path>
    <path d="M9.8 16.7 6.7 16.2M10.1 18.9 7.1 19.7M22.2 16.7 25.3 16.2M21.9 18.9 24.9 19.7"></path>
    <path d="M15.4 18.7h1.2"></path>
  </g>
  <circle cx="13.6" cy="16" r="1" fill="var(--brand-line)"></circle>
  <circle cx="18.4" cy="16" r="1" fill="var(--brand-line)"></circle>
</svg>
