---
import 'katex/dist/katex.min.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../../../styles/prose.css';

import Base from '../../../layouts/Base.astro';
import CsrfField from '../../../components/account/CsrfField.astro';
import { getNoteByUserAndSlug } from '../../../lib/server/user-notes';
import { renderUserMarkdown } from '../../../markdown/user.mjs';

if (!Astro.locals.user) {
  return Astro.redirect('/logowanie?next=' + encodeURIComponent(Astro.url.pathname));
}

const slug = Astro.params.slug!;
const note = await getNoteByUserAndSlug(Astro.locals.user.id, slug);
if (!note) {
  return Astro.redirect('/moje/?error=' + encodeURIComponent('Nie ma takiej notatki.'));
}

const error = Astro.url.searchParams.get('error');
const ok = Astro.url.searchParams.get('ok');
const { html } = await renderUserMarkdown(note.body);
---

<Base title={`Edycja · ${note.title}`} description="Edytuj notatkę Markdown.">
  <header class="page-head">
    <h1 class="page-title">Edycja</h1>
    <p class="page-lead">{note.title}</p>
  </header>

  {error && <p class="form-error">{error}</p>}
  {ok && <p class="form-ok">{ok}</p>}

  <div class="editor-layout is-split">
    <form class="note-form" method="post" action="/api/notes/update">
      <CsrfField />
      <input type="hidden" name="slug" value={note.slug} />
      <div class="field">
        <label for="title">Tytuł</label>
        <input id="title" name="title" required maxlength="200" value={note.title} />
      </div>
      <div class="field">
        <label for="description">Krótki opis</label>
        <input id="description" name="description" maxlength="500" value={note.description ?? ''} />
      </div>
      <div class="field">
        <label for="body">Treść Markdown</label>
        <textarea id="body" name="body" spellcheck="true">{note.body}</textarea>
      </div>
      <div class="form-actions">
        <button class="button" type="submit">Zapisz</button>
        <a class="button button-secondary" href={`/moje/${note.slug}/`}>Podgląd</a>
      </div>
    </form>

    <aside class="editor-preview" aria-label="Podgląd">
      <p class="editor-preview-label">Podgląd zapisanej treści</p>
      <div class="prose" set:html={html} />
    </aside>
  </div>
</Base>
