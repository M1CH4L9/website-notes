---
import 'katex/dist/katex.min.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../../../styles/prose.css';

import Base from '../../../layouts/Base.astro';
import CsrfField from '../../../components/account/CsrfField.astro';
import NoteScripts from '../../../components/NoteScripts.astro';
import Toc from '../../../components/Toc.astro';
import { formatDate, isoDate } from '../../../lib/format';
import { noteUrl } from '../../../lib/notes';
import { getNoteByUserAndSlug } from '../../../lib/server/user-notes';
import { getPublicationForSourceNote } from '../../../lib/server/publication-notes';
import { latestRequestForNote } from '../../../lib/server/publications';
import { listSubjectOptions } from '../../../lib/server/subject-options';
import { listSharesForNote } from '../../../lib/server/shares';
import { renderUserMarkdown } from '../../../markdown/user.mjs';

if (!Astro.locals.user) {
  return Astro.redirect('/logowanie?next=' + encodeURIComponent(Astro.url.pathname));
}

const slug = Astro.params.slug!;
const note = await getNoteByUserAndSlug(Astro.locals.user.id, slug);
if (!note) {
  return Astro.redirect('/moje/?error=' + encodeURIComponent('Nie ma takiej notatki.'));
}

const { html, headings } = await renderUserMarkdown(note.body);
const request = await latestRequestForNote(note.id);
const publication = await getPublicationForSourceNote(note.id);
const shares = await listSharesForNote(note.id);
const subjects = await listSubjectOptions();
const error = Astro.url.searchParams.get('error');
const ok = Astro.url.searchParams.get('ok');
const newShareToken = Astro.url.searchParams.get('share');
const newSharePerm = Astro.url.searchParams.get('perm') === 'edit' ? 'edit' : 'read';
const pending = request?.status === 'pending';
const canPublish = !publication && !pending;
const canUpdate = Boolean(publication) && !pending;
const origin = Astro.url.origin;
const newShareUrl = newShareToken ? `${origin}/w/${newShareToken}/` : null;
---

<Base title={note.title} description={note.description ?? undefined}>
  {
    newShareUrl && (
        <div class="editor-toast share-toast" data-share-toast role="status">
        <p class="share-toast-text">
          Utworzono link {newSharePerm === 'edit' ? 'do edycji' : 'do odczytu'}:{' '}
          <a href={newShareUrl}>{newShareUrl}</a>
        </p>
        <button
          class="button button-secondary share-copy-button"
          type="button"
          data-share-copy
          data-share-copy-url={newShareUrl}
        >
          Kopiuj
        </button>
      </div>
    )
  }

  <div class="account-toolbar">
    <nav class="account-nav">
      <a class="button button-secondary" href="/moje/">Wróć</a>
      <a class="button" href={`/moje/${note.slug}/edytuj/`}>Edytuj</a>
      {
        publication && (
          <a class="button button-secondary" href={noteUrl(publication.subject_slug, publication.slug)}>
            Widok publiczny
          </a>
        )
      }
    </nav>
    <form method="post" action="/api/notes/delete" onsubmit="return confirm('Usunąć tę notatkę? Publikacja na stronie (jeśli jest) zostaje.');">
      <CsrfField />
      <input type="hidden" name="slug" value={note.slug} />
      <button class="button button-danger" type="submit">Usuń</button>
    </form>
  </div>

  {error && <p class="form-error">{error}</p>}
  {ok && <p class="form-ok">{ok}</p>}

  <div class="note-layout">
    <article class="note-main">
      <header class="note-head">
        <h1 class="page-title">{note.title}</h1>
        {note.description && <p class="page-lead">{note.description}</p>}
        <p class="page-meta">
          <span>
            Aktualizacja: <time datetime={isoDate(note.updated_at)}>{formatDate(note.updated_at)}</time>
          </span>
          {
            publication ? (
              <span class="badge badge-public">opublikowana</span>
            ) : pending ? (
              <span class="badge badge-pending">czeka na akceptację</span>
            ) : (
              <span class="badge">prywatna</span>
            )
          }
        </p>
        {
          publication && (
            <p class="hint">
              Publikacja:{' '}
              <a href={noteUrl(publication.subject_slug, publication.slug)}>
                /przedmioty/{publication.subject_slug}/{publication.slug}/
              </a>
              {' '}(edycje lokalne nie zmieniają publikacji, dopóki nie wyślesz aktualizacji)
            </p>
          )
        }
      </header>

      <Toc headings={headings} variant="mobile" />
      <div class="prose" set:html={html} />
    </article>
    <aside class="note-aside">
      <Toc headings={headings} variant="desktop" />
    </aside>
  </div>

  {
    canPublish && (
      <section class="publish-request-panel" data-publish-panel>
        <h2 class="publish-request-title">Prośba o upublicznienie</h2>
        <p class="publish-request-lead">
          Po akceptacji snapshot trafi na stronę główną w wybranym przedmiocie. Linki współdzielone to osobna sprawa.
        </p>
        <form class="auth-form" method="post" action="/api/notes/publish-request">
          <CsrfField />
          <input type="hidden" name="slug" value={note.slug} />
          <input type="hidden" name="kind" value="publish" />

          <fieldset class="publish-subject-fieldset">
            <legend>Przedmiot</legend>
            <label class="choice-row">
              <input type="radio" name="subject_mode" value="existing" checked data-subject-mode />
              <span>Istniejący</span>
            </label>
            <div class="field" data-subject-existing>
              <label class="visually-hidden" for="subject_slug">Przedmiot</label>
              <select id="subject_slug" name="subject_slug" required>
                <option value="">Wybierz…</option>
                {subjects.map((s) => (
                  <option value={s.slug}>
                    {s.title}
                    {s.fullName ? ` - ${s.fullName}` : ''}
                  </option>
                ))}
              </select>
            </div>

            <label class="choice-row">
              <input type="radio" name="subject_mode" value="new" data-subject-mode />
              <span>Zgłoś nowy</span>
            </label>
            <div class="publish-new-subject" data-subject-new hidden>
              <div class="field">
                <label for="proposed_subject_title">Nazwa (np. BSI)</label>
                <input id="proposed_subject_title" name="proposed_subject_title" maxlength="80" />
              </div>
              <div class="field">
                <label for="proposed_subject_full_name">Pełna nazwa (opcjonalnie)</label>
                <input id="proposed_subject_full_name" name="proposed_subject_full_name" maxlength="200" />
              </div>
              <div class="field">
                <label for="proposed_subject_description">Opis (opcjonalnie)</label>
                <input id="proposed_subject_description" name="proposed_subject_description" maxlength="500" />
              </div>
            </div>
          </fieldset>

          <div class="field">
            <label for="message">Wiadomość do admina (opcjonalnie)</label>
            <input id="message" name="message" maxlength="500" />
          </div>
          <button class="button" type="submit">Wyślij prośbę</button>
        </form>
      </section>
    )
  }

  {
    canUpdate && publication && (
      <section class="publish-request-panel" data-publish-panel>
        <h2 class="publish-request-title">Zaktualizuj publikację</h2>
        <p class="publish-request-lead">
          Wysyła snapshot bieżącej prywatnej notatki. Admin akceptuje; możesz ograniczyć pola.
        </p>
        <form class="auth-form" method="post" action="/api/notes/publish-request">
          <CsrfField />
          <input type="hidden" name="slug" value={note.slug} />
          <input type="hidden" name="kind" value="update" />

          <fieldset class="publish-apply-fieldset">
            <legend>Co zaktualizować</legend>
            <label class="choice-row">
              <input type="checkbox" name="apply_title" checked />
              <span>Tytuł</span>
            </label>
            <label class="choice-row">
              <input type="checkbox" name="apply_description" checked />
              <span>Opis</span>
            </label>
            <label class="choice-row">
              <input type="checkbox" name="apply_body" checked />
              <span>Treść</span>
            </label>
            <label class="choice-row">
              <input type="checkbox" name="apply_subject" data-apply-subject />
              <span>Przedmiot</span>
            </label>
          </fieldset>

          <div data-update-subject hidden>
            <fieldset class="publish-subject-fieldset">
              <legend>Nowy przedmiot</legend>
              <label class="choice-row">
                <input type="radio" name="subject_mode" value="existing" checked data-subject-mode />
                <span>Istniejący</span>
              </label>
              <div class="field" data-subject-existing>
                <label class="visually-hidden" for="subject_slug_upd">Przedmiot</label>
                <select id="subject_slug_upd" name="subject_slug">
                  <option value="">Wybierz…</option>
                  {subjects.map((s) => (
                    <option value={s.slug} selected={s.slug === publication.subject_slug}>
                      {s.title}
                      {s.fullName ? ` - ${s.fullName}` : ''}
                    </option>
                  ))}
                </select>
              </div>
              <label class="choice-row">
                <input type="radio" name="subject_mode" value="new" data-subject-mode />
                <span>Zgłoś nowy</span>
              </label>
              <div class="publish-new-subject" data-subject-new hidden>
                <div class="field">
                  <label for="proposed_subject_title_upd">Nazwa</label>
                  <input id="proposed_subject_title_upd" name="proposed_subject_title" maxlength="80" />
                </div>
                <div class="field">
                  <label for="proposed_subject_full_name_upd">Pełna nazwa (opcjonalnie)</label>
                  <input
                    id="proposed_subject_full_name_upd"
                    name="proposed_subject_full_name"
                    maxlength="200"
                  />
                </div>
                <div class="field">
                  <label for="proposed_subject_description_upd">Opis (opcjonalnie)</label>
                  <input
                    id="proposed_subject_description_upd"
                    name="proposed_subject_description"
                    maxlength="500"
                  />
                </div>
              </div>
            </fieldset>
          </div>

          <div class="field">
            <label for="message_upd">Wiadomość (opcjonalnie)</label>
            <input id="message_upd" name="message" maxlength="500" />
          </div>
          <button class="button" type="submit">Zaktualizuj publikację</button>
        </form>
      </section>
    )
  }

  {
    pending && (
      <section class="publish-request-panel">
        <h2 class="publish-request-title">Prośba oczekuje</h2>
        <p class="publish-request-lead">
          {request?.kind === 'update' ? 'Aktualizacja' : 'Upublicznienie'} wysłane
          {
            request?.created_at && (
              <>
                {' '}
                <time datetime={isoDate(request.created_at)}>{formatDate(request.created_at)}</time>
              </>
            )
          }
          . Admin rozpatrzy ją w panelu.
        </p>
      </section>
    )
  }

  <section class="publish-request-panel">
    <h2 class="publish-request-title">Udostępnij</h2>
    <p class="publish-request-lead">
      Link do prywatnej notatki (nie publikuje na homepage). Odczyt bez konta; edycja z tokenem edit
      (konto opcjonalne, wtedy widać nick przy obecności).
    </p>

    <form class="auth-form" method="post" action="/api/notes/share-create">
      <CsrfField />
      <input type="hidden" name="slug" value={note.slug} />
      <div class="field">
        <label for="permission">Uprawnienie</label>
        <select id="permission" name="permission">
          <option value="read">Tylko odczyt</option>
          <option value="edit">Edycja</option>
        </select>
      </div>
      <div class="field">
        <label for="label">Etykieta (opcjonalnie)</label>
        <input id="label" name="label" maxlength="80" placeholder="np. grupa lab" />
      </div>
      <button class="button" type="submit">Generuj link</button>
    </form>

    {
      shares.length > 0 && (
        <ul class="share-list">
          {shares.map((share) => {
            const shareUrl = `${origin}/w/${share.token}/`;
            return (
              <li class="share-list-item">
                <div>
                  <div class="share-url-row">
                    <a href={shareUrl}>{shareUrl}</a>
                    <button
                      class="button button-secondary share-copy-button"
                      type="button"
                      data-share-copy
                      data-share-copy-url={shareUrl}
                    >
                      Kopiuj
                    </button>
                  </div>
                  <div class="my-note-list-meta">
                    <span class="badge">{share.permission === 'edit' ? 'edycja' : 'odczyt'}</span>
                    {share.label && <span>{share.label}</span>}
                    <span>
                      <time datetime={isoDate(share.created_at)}>{formatDate(share.created_at)}</time>
                    </span>
                    {share.permission === 'edit' && (
                      <a href={`/w/${share.token}/edytuj/`}>Otwórz edytor</a>
                    )}
                  </div>
                </div>
                <form method="post" action="/api/notes/share-revoke">
                  <CsrfField />
                  <input type="hidden" name="slug" value={note.slug} />
                  <input type="hidden" name="share_id" value={share.id} />
                  <button class="button button-danger" type="submit">
                    Unieważnij
                  </button>
                </form>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>

  <NoteScripts />

  <script>
    async function copyShareUrl(value: string): Promise<boolean> {
      try {
        await navigator.clipboard.writeText(value);
        return true;
      } catch {
        const area = document.createElement('textarea');
        area.value = value;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.append(area);
        area.select();
        let ok = false;
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        area.remove();
        return ok;
      }
    }

    function bindShareCopy() {
      document.querySelectorAll<HTMLButtonElement>('[data-share-copy]').forEach((button) => {
        if (button.dataset.ready === '1') return;
        button.dataset.ready = '1';
        button.addEventListener('click', async () => {
          const url = button.dataset.shareCopyUrl ?? '';
          if (!url) return;
          const ok = await copyShareUrl(url);
          const previous = button.textContent;
          button.textContent = ok ? 'Skopiowano' : 'Nie udało się';
          window.setTimeout(() => {
            button.textContent = previous || 'Kopiuj';
          }, 1800);
        });
      });
    }

    function bindShareToasts() {
      for (const toast of document.querySelectorAll<HTMLElement>('[data-share-toast]')) {
        if (toast.dataset.ready === '1') continue;
        toast.dataset.ready = '1';
        window.setTimeout(() => {
          toast.classList.add('is-leaving');
          window.setTimeout(() => toast.remove(), 220);
        }, 8000);
      }
    }

    function bindPublishPanels() {
      document.querySelectorAll('[data-publish-panel]').forEach((panel) => {
        const applySubject = panel.querySelector('[data-apply-subject]');
        const updateSubject = panel.querySelector('[data-update-subject]');
        if (applySubject instanceof HTMLInputElement && updateSubject instanceof HTMLElement) {
          const syncApply = () => {
            updateSubject.hidden = !applySubject.checked;
          };
          applySubject.addEventListener('change', syncApply);
          syncApply();
        }

        const syncMode = () => {
          const checked = panel.querySelector('input[name="subject_mode"]:checked');
          const mode = checked instanceof HTMLInputElement ? checked.value : 'existing';
          const existing = panel.querySelector('[data-subject-existing]');
          const neu = panel.querySelector('[data-subject-new]');
          if (existing instanceof HTMLElement) existing.hidden = mode !== 'existing';
          if (neu instanceof HTMLElement) neu.hidden = mode !== 'new';
          const select = existing?.querySelector('select');
          const titleInput = neu?.querySelector('input[name="proposed_subject_title"]');
          if (select instanceof HTMLSelectElement) {
            select.required = mode === 'existing' && !existing?.hasAttribute('hidden');
          }
          if (titleInput instanceof HTMLInputElement) {
            titleInput.required = mode === 'new' && !(neu?.hasAttribute('hidden'));
          }
        };

        panel.querySelectorAll('[data-subject-mode]').forEach((radio) => {
          radio.addEventListener('change', syncMode);
        });
        syncMode();
      });
    }

    const bootShareUi = () => {
      bindPublishPanels();
      bindShareCopy();
      bindShareToasts();
    };

    bootShareUi();
    document.addEventListener('astro:page-load', bootShareUi);
  </script>
</Base>
