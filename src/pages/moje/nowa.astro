---
import 'katex/dist/katex.min.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../../styles/prose.css';

import Base from '../../layouts/Base.astro';
import NoteEditor from '../../components/account/NoteEditor.astro';

if (!Astro.locals.user) {
  return Astro.redirect('/logowanie?next=' + encodeURIComponent('/moje/nowa/'));
}

const error = Astro.url.searchParams.get('error');
---

<Base title="Nowa notatka" description="Utwórz notatkę Markdown.">
  <header class="page-head">
    <h1 class="page-title">Nowa notatka</h1>
    <p class="page-lead">Ten sam Markdown co w notatkach publicznych: kod, tabele, wzory, callouty.</p>
  </header>

  {error && <p class="form-error">{error}</p>}

  <NoteEditor
    action="/api/notes/create"
    submitLabel="Utwórz"
    cancelHref="/moje/"
    showSlug={true}
  />
</Base>
