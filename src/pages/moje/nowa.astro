---
import 'katex/dist/katex.min.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../../styles/prose.css';

import Base from '../../layouts/Base.astro';
import { listNoteFolders } from '../../lib/server/note-folders';
import NoteEditor from '../../components/account/NoteEditor.astro';

if (!Astro.locals.user) {
  return Astro.redirect('/logowanie?next=' + encodeURIComponent('/moje/nowa/'));
}

const folder = (await listNoteFolders(Astro.locals.user.id)).find(item => item.id === Astro.url.searchParams.get('folder'));
const error = Astro.url.searchParams.get('error');
---

<Base title="Nowa notatka" description="Utwórz notatkę Markdown." wide editor>
  {error && <p class="form-error editor-banner">{error}</p>}

  <NoteEditor
    action="/api/notes/create"
    submitLabel="Utwórz"
    cancelHref={folder ? `/moje/?folder=${folder.id}` : "/moje/"}
    folder={folder}
    showSlug={true}
  />
</Base>
