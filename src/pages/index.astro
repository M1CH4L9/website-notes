---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CatArt from '../components/CatArt.astro';
import { getCollection } from 'astro:content';
const notes = (await getCollection('notes')).sort((a,b) => a.data.order - b.data.order);
const categories = [...new Set(notes.map(n => n.data.category))];
const subjects = [...new Set(notes.map(n => n.data.subject))];
---
<Layout>
 <div class="page-wrap">
  <section class="hero" aria-labelledby="welcome">
   <div class="hero-copy"><span class="eyebrow"><span class="tiny-star">✧</span> TWOJE MAŁE MIEJSCE NA WIEDZĘ</span><h1 id="welcome">Wielkie rzeczy zaczynają się<br/>od <em>małych notatek.</em></h1><p>Uporządkuj myśli. Rozgryź trudny temat.<br/>Ucz się po swojemu — notatka po notatce.</p><a class="hero-link" href="#biblioteka">Zajrzyj do biblioteki <Icon name="arrow" size={17}/></a></div>
   <div class="hero-art"><span class="art-caption">chwila na małe odkrycie</span><CatArt/><span class="art-doodle">✧</span></div>
  </section>
  <section class="library" id="biblioteka" aria-labelledby="library-title">
   <div class="section-heading"><div><div class="eyebrow muted">OD CZEGO DZIŚ ZACZYNAMY?</div><h2 id="library-title">Twoja biblioteka <span class="heading-spark">✳</span></h2></div><span class="note-count">{notes.length} notatek · {subjects.length === 1 ? '1 przedmiot' : `${subjects.length} przedmiotów`}</span></div>
   <div class="library-layout">
    <aside class="subjects" aria-label="Przedmioty"><span class="sidebar-label">PRZEDMIOTY</span>{subjects.map((subject, index) => <button class:list={["subject-button", {active: index === 0}]} data-subject={subject} aria-pressed={index === 0 ? "true" : "false"}><span class="subject-icon"><Icon name="shield"/></span><span><strong>{subject}</strong><small>{subject === 'BSI' ? 'Bezpieczeństwo systemów' : subject}</small></span><span class="subject-count">{notes.filter(n=>n.data.subject===subject).length}</span></button>)}<div class="sidebar-note"><Icon name="cat" size={29}/><p>Wiedza lubi mieć<br/>swoje miejsce.</p><span>Kolejne przedmioty? Z czasem!</span></div></aside>
    <div class="library-content">
     <div class="search-wrap"><Icon name="search" size={21}/><label class="sr-only" for="search">Szukaj notatek</label><input id="search" type="search" placeholder="Czego chcesz się dziś nauczyć?" autocomplete="off"/><kbd aria-hidden="true">/</kbd></div>
     <div class="filters" role="group" aria-label="Filtruj według kategorii"><button class="filter active" data-category="all" aria-pressed="true">Wszystkie <span>{notes.length}</span></button>{categories.map(c=><button class="filter" data-category={c} aria-pressed="false">{c}</button>)}</div>
     <div class="cards">{notes.map(note=><a class="note-card" href={`/notatki/${note.id}/`} data-category={note.data.category} data-subject={note.data.subject} data-search={`${note.data.title} ${note.data.description} ${note.data.tags.join(' ')}`}><div class="card-top"><span class={`card-icon icon-${note.data.icon}`}><Icon name={note.data.icon} size={23}/></span>{note.data.demo && <span class="demo-label">PRZYKŁAD</span>}</div><span class="card-category">{note.data.category}</span><h3>{note.data.title}</h3><p>{note.data.description}</p><div class="tags">{note.data.tags.map(tag=><span>{tag}</span>)}</div><div class="card-bottom"><span><Icon name="clock" size={14}/>{Math.max(1,Math.ceil((note.body || '').split(/\s+/).length/200))} min czytania</span><span class="card-arrow"><Icon name="arrow" size={18}/></span></div></a>)}</div>
     <div class="empty-state" hidden><Icon name="search" size={32}/><h3>Tu jeszcze nic nie ma</h3><p>Spróbuj innego hasła lub wyczyść filtry.</p><button id="reset" class="primary-button">Wyczyść filtry</button></div>
     <p id="search-status" class="sr-only" role="status" aria-live="polite"></p>
     {notes.some(n => n.data.demo) && <div class="demo-notice"><Icon name="info" size={17}/><p>Na razie rozgość się. To przykładowe notatki — prawdziwa wiedza pojawi się tutaj wkrótce.</p></div>}
    </div>
   </div>
  </section>
  <div class="closing-note"><span>✧</span> Nie wszystko naraz. Jedna notatka też robi różnicę. <span>✧</span></div>
 </div>
 <script>
  const search = document.querySelector<HTMLInputElement>('#search')!;
  const cards = [...document.querySelectorAll<HTMLElement>('.note-card')];
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-category].filter')];
  const subjects = [...document.querySelectorAll<HTMLButtonElement>('.subject-button')];
  let category = 'all'; let subject = subjects[0]?.dataset.subject;
  const normalize = (s: string) => s.toLocaleLowerCase('pl').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/ł/g,'l');
  function update() {
   const query = normalize(search.value.trim()); let count = 0;
   cards.forEach(card => { const show = (!subject || card.dataset.subject === subject) && (category === 'all' || card.dataset.category === category) && normalize(card.dataset.search || '').includes(query); card.hidden = !show; if(show) count++; });
   document.querySelector<HTMLElement>('.empty-state')!.hidden = count !== 0;
   document.querySelector('#search-status')!.textContent = `Liczba znalezionych notatek: ${count}.`;
   filters.forEach(b => { const active = b.dataset.category === category; b.classList.toggle('active',active); b.setAttribute('aria-pressed',String(active)); });
   subjects.forEach(b => { const active = b.dataset.subject === subject; b.classList.toggle('active',active); b.setAttribute('aria-pressed',String(active)); });
  }
  search.addEventListener('input',update);
  filters.forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category!;update();}));
  subjects.forEach(b=>b.addEventListener('click',()=>{subject=b.dataset.subject;update();}));
  document.querySelector('#reset')!.addEventListener('click',()=>{search.value='';category='all';update();search.focus();});
  document.addEventListener('keydown',e=>{if(e.key==='/' && !e.ctrlKey && !e.metaKey && !(e.target instanceof HTMLInputElement) && !(e.target instanceof HTMLTextAreaElement) && !(e.target instanceof HTMLSelectElement)){e.preventDefault();search.focus();}});
  update();
 </script>
</Layout>
