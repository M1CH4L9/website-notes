---
import 'katex/dist/katex.min.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../../../styles/prose.css';

import { render } from 'astro:content';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatPeek from '../../../components/CatPeek.astro';
import NoteDownload from '../../../components/NoteDownload.astro';
import NoteScripts from '../../../components/NoteScripts.astro';
import NoteSearch from '../../../components/NoteSearch.astro';
import Toc from '../../../components/Toc.astro';
import Base from '../../../layouts/Base.astro';
import { formatDate, isoDate } from '../../../lib/format';
import { noteFilename } from '../../../lib/note-export';
import { folderBreadcrumbs, getFileSubject, getSubjects } from '../../../lib/notes';
import { getPublication } from '../../../lib/server/publication-notes';

const subjectSlug = Astro.params.subject!;
const slug = Astro.params.note!;
const fileSubject = await getFileSubject(subjectSlug);
const fileNote = fileSubject?.notes.find(item => item.slug === slug);

// Stary link do pojedynczego zadania otwiera jego nagłówek w zestawie.
const task = subjectSlug === 'bsi' && /^zadanie-([1-7])-(\d+)(p?)$/.exec(slug);
if (task && !fileNote) {
  const [, exercise, number, extra] = task;
  const sheet = fileSubject?.notes.find(item => item.slug === `cw0${exercise}${extra ? '_p' : ''}`);
  if (sheet?.entry) {
    const heading = (await render(sheet.entry)).headings.find(h => h.text.startsWith(`${exercise}.${number}${extra} - `));
    if (heading) return Astro.redirect(`${sheet.url}#${encodeURIComponent(heading.slug)}`, 301);
  }
}

// Foldery mają tylko treści plikowe. Publikacje pojawiają się na poziomie przedmiotu.
const subject = fileNote?.folder ? fileSubject : (await getSubjects(subjectSlug))[0];
if (!subject) return Astro.redirect('/404');
const note = subject.notes.find(item => item.slug === slug);
if (!note) {
  return Astro.redirect('/404');
}
const siblings = subject.notes.filter(item => !item.archive && (item.folder ?? '') === (note.folder ?? ''));
const siblingIndex = siblings.indexOf(note);
const previous = siblingIndex >= 0 ? siblings[siblingIndex - 1] : undefined;
const next = siblingIndex >= 0 ? siblings[siblingIndex + 1] : undefined;

let Content: Awaited<ReturnType<typeof render>>['Content'] | null = null;
let headings: { depth: number; slug: string; text: string }[] = [];
let html: string | null = null;

if (note.entry) {
  const rendered = await render(note.entry);
  Content = rendered.Content;
  headings = rendered.headings;
} else if (note.publication) {
  const publication = await getPublication(subjectSlug, slug);
  if (!publication) return Astro.redirect('/404');
  const { renderUserMarkdown } = await import('../../../markdown/user.mjs');
  const rendered = await renderUserMarkdown(publication.body);
  html = rendered.html;
  headings = rendered.headings;
}

const downloadHref = note.publication
  ? `/api/notes/download?kind=publication&id=${encodeURIComponent(note.publication.id)}`
  : `/api/notes/download?kind=public&subject=${encodeURIComponent(subject.slug)}&note=${encodeURIComponent(note.slug)}`;
const pdfFilename = noteFilename(note.slug, note.title);

const copyHref = note.publication
  ? `/moje/z-publicznej?subject=${subject.slug}&note=${note.slug}&pub=${note.publication.id}`
  : `/moje/z-publicznej?subject=${subject.slug}&note=${note.slug}`;
---

<Base title={`${note.title} · ${subject.title}`} description={note.description}>
  <Breadcrumbs
    items={[
      { label: 'Przedmioty', href: '/' },
      { label: subject.title, href: subject.url },
      ...folderBreadcrumbs(subject, note.folder || ''),
    ]}
  />

  <div class="note-layout">
    <article class="note-main">
      <header class="note-head">
        <h1 class="page-title">{note.title}</h1>
        {note.description && <p class="page-lead">{note.description}</p>}
        {
          note.updated && (
            <p class="page-meta">
              Aktualizacja: <time datetime={isoDate(note.updated)}>{formatDate(note.updated)}</time>
              {note.authorUsername && <span>· @{note.authorUsername}</span>}
            </p>
          )
        }
        <div class="note-head-actions">
          <NoteDownload mdHref={downloadHref} filename={pdfFilename} />
          <a class="button" href={copyHref}>Skopiuj do moich notatek</a>
        </div>
      </header>

      <NoteSearch variant="mobile" />
      <Toc headings={headings} variant="mobile" />

      {
        Content ? (
          <div class="prose">
            <Content />
          </div>
        ) : (
          <div class="prose" set:html={html || ''} />
        )
      }

      {
        (previous || next) && (
          <nav class="note-pager" aria-label="Sąsiednie notatki">
            <CatPeek class="pager-cat" />
            {previous && (
              <a class="pager-link is-previous" data-astro-prefetch href={previous.url} rel="prev">
                <span class="pager-label">Poprzednia</span>
                <span class="pager-title">{previous.title}</span>
              </a>
            )}
            {next && (
              <a class="pager-link is-next" data-astro-prefetch href={next.url} rel="next">
                <span class="pager-label">Następna</span>
                <span class="pager-title">{next.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>

    <aside class="note-aside">
      <NoteSearch variant="desktop" />
      <Toc headings={headings} variant="desktop" />
    </aside>
  </div>

  <NoteScripts />
</Base>
