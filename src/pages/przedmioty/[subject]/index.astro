---
import SubjectItems from '../../../components/SubjectItems.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Base from '../../../layouts/Base.astro';
import { getSubjects } from '../../../lib/notes';

const [subject] = await getSubjects(Astro.params.subject);
if (!subject) {
  return Astro.redirect('/404');
}
const heading = subject.fullName ?? subject.title;
---

<Base title={subject.title} description={subject.description ?? `Notatki z przedmiotu ${heading}.`}>
  <Breadcrumbs items={[{ label: 'Przedmioty', href: '/' }]} />

  <header class="page-head">
    <h1 class="page-title">{heading}</h1>
    {subject.description && <p class="page-lead">{subject.description}</p>}
  </header>

  <SubjectItems subject={subject} />
</Base>
