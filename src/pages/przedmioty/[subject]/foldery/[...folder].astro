---
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SubjectItems from '../../../../components/SubjectItems.astro';
import { folderBreadcrumbs, getFileSubject } from '../../../../lib/notes';

const subject = await getFileSubject(Astro.params.subject ?? '');
const folder = subject?.folders.find(item => item.path === Astro.params.folder);
if (!subject || !folder) return Astro.redirect('/404');
---
<Base title={`${folder.title} · ${subject.title}`} description={folder.description}>
  <Breadcrumbs items={[
    { label: 'Przedmioty', href: '/' },
    { label: subject.title, href: subject.url },
    ...folderBreadcrumbs(subject, folder.parent),
  ]} />
  <header class="page-head">
    <h1 class="page-title">{folder.title}</h1>
    {folder.description && <p class="page-lead">{folder.description}</p>}
  </header>
  <SubjectItems subject={subject} path={folder.path} />
  {subject.slug === 'bsi' && folder.path === 'rozwiazania' && <p class="auth-footer-links"><a href="/przedmioty/bsi/bsi-rozwiazania/">Wszystkie rozwiązania w jednej notatce</a></p>}
</Base>
