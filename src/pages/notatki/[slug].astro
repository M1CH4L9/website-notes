---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
export async function getStaticPaths() {
 const notes = (await getCollection('notes')).sort((a,b)=>a.data.order-b.data.order);
 return notes.map((note,index)=>({params:{slug:note.id},props:{note,previous:notes[index-1],next:notes[index+1]}}));
}
const {note,previous,next} = Astro.props;
const {Content,headings} = await render(note);
const toc = headings.filter(h=>h.depth===2 || h.depth===3);
const minutes = Math.max(1,Math.ceil((note.body || '').split(/\s+/).length/200));
---
<Layout title={`${note.data.title} — Notatnik`} description={note.data.description}>
 <div class="reader-wrap">
  <nav class="breadcrumbs" aria-label="Okruszki"><a href="/">Biblioteka</a><Icon name="chevron" size={12}/><span>{note.data.subject}</span><Icon name="chevron" size={12}/><span>{note.data.category}</span></nav>
  <div class="reader-grid"><article>
   <header class="article-header"><div class="article-label"><span class="card-icon"><Icon name={note.data.icon}/></span><span>{note.data.subject} / {note.data.category}</span></div><h1>{note.data.title}</h1><p class="article-description">{note.data.description}</p><div class="article-meta"><span><Icon name="clock" size={15}/>{minutes} min czytania</span>{note.data.demo && <><span>•</span><span>Notatka przykładowa</span></>}</div></header>
   {note.data.demo && <div class="demo-notice reader-demo"><Icon name="info" size={18}/><p>To tylko próbka wyglądu. Treść służy do testowania strony, nie do nauki BSI.</p></div>}
   <details class="mobile-toc"><summary>W tej notatce</summary><nav aria-label="Spis treści na telefonie">{toc.map(h=><a class:list={{nested:h.depth===3}} href={`#${h.slug}`}>{h.text}</a>)}</nav></details>
   <div class="prose"><Content/></div>
   <div class="article-ending"><Icon name="cat" size={25}/><span>Mały krok. Kolejny temat oswojony.</span></div>
   <nav class="article-pagination" aria-label="Sąsiednie notatki">{previous ? <a href={`/notatki/${previous.id}/`}><small>← POPRZEDNIA NOTATKA</small><strong>{previous.data.title}</strong></a>:<span/>}{next && <a href={`/notatki/${next.id}/`}><small>NASTĘPNA NOTATKA →</small><strong>{next.data.title}</strong></a>}</nav>
  </article>
  <aside class="desktop-toc"><div class="toc-sticky"><span class="sidebar-label">W TEJ NOTATCE</span><nav aria-label="Spis treści">{toc.map(h=><a class:list={{nested:h.depth===3}} href={`#${h.slug}`}>{h.text}</a>)}</nav><a class="toc-back" href="/">← Wszystkie notatki</a></div></aside>
  </div>
 </div>
 <script>
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach(pre=>{
   const code = pre.querySelector('code'); if(!code) return;
   const container = document.createElement('div'); container.className='code-block';
   const bar = document.createElement('div'); bar.className='code-toolbar';
   const label = document.createElement('span'); label.textContent=pre.dataset.language || 'kod';
   const button = document.createElement('button'); button.type='button';button.textContent='Kopiuj kod';button.setAttribute('aria-label',`Kopiuj kod ${label.textContent}`);
   const status=document.createElement('span');status.className='sr-only';status.setAttribute('role','status');
   button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(code.textContent || '');button.textContent='Skopiowano ✓';status.textContent='Kod skopiowany do schowka.';}catch{button.textContent='Zaznacz kod ręcznie';status.textContent='Nie udało się skopiować. Zaznacz kod i skopiuj ręcznie.';}setTimeout(()=>{button.textContent='Kopiuj kod';},2500);});
   bar.append(label,button,status);pre.before(container);container.append(bar,pre);pre.tabIndex=0;pre.setAttribute('aria-label',`Blok kodu ${label.textContent}`);
  });
  document.querySelectorAll('.prose table').forEach(table=>{const wrap=document.createElement('div');wrap.className='table-scroll';wrap.tabIndex=0;wrap.setAttribute('role','region');wrap.setAttribute('aria-label','Tabela z możliwością przewijania');table.before(wrap);wrap.append(table);});
  document.querySelectorAll<HTMLHeadingElement>('.prose h2, .prose h3').forEach(heading=>{const link=document.createElement('a');link.href=`#${heading.id}`;link.className='heading-anchor';link.textContent='#';link.setAttribute('aria-label',`Link do sekcji: ${heading.textContent}`);heading.append(link);});
  const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){document.querySelectorAll('.desktop-toc a').forEach(a=>{const active=a.getAttribute('href')===`#${entry.target.id}`;a.classList.toggle('current',active);if(active)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');});}});},{rootMargin:'-10% 0px -65% 0px'});
  document.querySelectorAll('.prose h2, .prose h3').forEach(h=>observer.observe(h));
 </script>
</Layout>
