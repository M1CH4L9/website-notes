---
import { getPublicNote } from '../../../lib/server/user-notes';
import { getPublicationForSourceNote } from '../../../lib/server/publication-notes';
import { isDatabaseConfigured } from '../../../lib/server/env';
import { noteUrl } from '../../../lib/notes';

const username = Astro.params.username!;
const slug = Astro.params.slug!;

if (!isDatabaseConfigured()) {
  return new Response('Baza nie jest podłączona.', { status: 503 });
}

const note = await getPublicNote(username, slug);
if (!note) {
  return Astro.redirect('/404');
}

const publication = await getPublicationForSourceNote(note.id);
if (publication) {
  return Astro.redirect(noteUrl(publication.subject_slug, publication.slug));
}

// Stare is_public bez snapshotu publikacji.
return Astro.redirect('/404');
---
